#ifndef DRMCTL_H
#define DRMCTL_H

#include "util.h"
#include "shm/allocator.h"
#include "agfx/agfxplane.h"

#include <stdint.h>
#include <drm/drm.h>
#include <drm/drm_mode.h>
#include <fcntl.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/mman.h>
#include <sys/ioctl.h>

struct drm_ctl {
	int drm_fd; /* * */
	uint32_t handle; /* * */
	uint32_t fb_id; /* * */
	uint32_t line_length; /* * */
	uint32_t connector_id; /* * */
	uint32_t encoder_id; /* * */
	uint32_t crtc_id; /* * */
	struct drm_mode_card_res res; /* * */
	struct drm_mode_crtc crtc; /* * */
	struct drm_mode_modeinfo mode; /* * */
	char *mapped_fb; /* * */
	uint64_t size; /* * */
	uint64_t mapped_offset; /* * */

	struct agfx_plane input_plane; /* * */
};

int  is_drm_available();
int  init_drm_ctl(struct shm_allocator_pdata *pd, shmptr_of(struct drm_ctl) dc);
void free_drm_ctl(struct shm_allocator_pdata *pd, shmptr_of(struct drm_ctl) dc);
shmptr_of(struct agfx_plane) get_drm_agfx_plane(struct shm_allocator_pdata *pd, shmptr_of(struct drm_ctl) dc);
void flush_drm_ctl(struct shm_allocator_pdata *pd, shmptr_of(struct drm_ctl) dc);

#endif

