#include "drmctl.h"

#include <string.h>
#include <stdlib.h>

static char *devices[] = {
	"/dev/dri/card1", /* apparently the discrete GPU */
	"/dev/dri/card0", /* apparently the integrated GPU */
	"/dev/dri/card2",
	NULL,
};

static int check_device(char *name, int *fd, struct drm_mode_card_res *res, uint32_t *con_id, uint32_t *encoder_id, uint32_t *crtc_id, struct drm_mode_modeinfo *mode);
static int check_devices(char **names, int *fd, struct drm_mode_card_res *res, uint32_t *con_id, uint32_t *encoder_id, uint32_t *crtc_id, struct drm_mode_modeinfo *mode);

int
is_drm_available()
{
	int fd;
	struct drm_mode_card_res res;
	uint32_t con_id, encoder_id, crtc_id;
	struct drm_mode_modeinfo mode;

	if(check_devices(devices, &fd, &res, &con_id, &encoder_id, &crtc_id, &mode)) {
		if(close(fd) < 0) {
			return 0;
		}

		return 1;
	} else {
		return 0;
	}
}

int
init_drm_ctl(struct shm_allocator_pdata *pd, shmptr_of(struct drm_ctl) dc)
{
	struct drm_ctl *pdc;
	struct agfx_channel r, g, b;
	struct agfx_pixel def;
	struct drm_mode_create_dumb creq;
	struct drm_mode_fb_cmd fbreq;
	struct drm_mode_map_dumb mreq;
	struct drm_mode_destroy_dumb destroyreq;
	struct drm_mode_crtc crtc;

	shm_access(pd);

	pdc = fromshmptr(struct drm_ctl, *pd, dc);

	if(! check_devices(devices, &pdc->drm_fd, &pdc->res, &pdc->connector_id, &pdc->encoder_id, &pdc->crtc_id, &pdc->mode)) {
		shm_leave(pd);
		return STUI_ERR;
	}

	if (ioctl(pdc->drm_fd, DRM_IOCTL_SET_MASTER, NULL) < 0) {
		shm_leave(pd);
		return STUI_ERR;
	}

	memset(&creq, 0, sizeof(struct drm_mode_create_dumb));
	creq.width  = pdc->mode.hdisplay;
	creq.height = pdc->mode.vdisplay;
	creq.bpp    = 32;

	if(ioctl(pdc->drm_fd, DRM_IOCTL_MODE_CREATE_DUMB, &creq) < 0) {
		shm_leave(pd);
		return STUI_ERR;
	}

	pdc->handle      = creq.handle;
	pdc->line_length = creq.pitch;
	pdc->size        = creq.size;

	memset(&fbreq, 0, sizeof(struct drm_mode_fb_cmd));
	fbreq.width  = pdc->mode.hdisplay;
	fbreq.height = pdc->mode.vdisplay;
	fbreq.pitch  = creq.pitch;
	fbreq.bpp    = 32;
	fbreq.depth  = 24;
	fbreq.handle = creq.handle;

	if(ioctl(pdc->drm_fd, DRM_IOCTL_MODE_ADDFB, &fbreq) < 0) {
		goto error_dumb;
	}

	pdc->fb_id = fbreq.fb_id;

	memset(&mreq, 0, sizeof(struct drm_mode_map_dumb));
	mreq.handle = creq.handle;

	if(ioctl(pdc->drm_fd, DRM_IOCTL_MODE_MAP_DUMB, &mreq) < 0) {
		goto error_dumb;
	}

	pdc->mapped_offset = mreq.offset;
	pdc->mapped_fb = mmap(NULL, creq.size, PROT_READ | PROT_WRITE, MAP_SHARED, pdc->drm_fd, mreq.offset);
	if(pdc->mapped_fb == MAP_FAILED) {
		goto error_fb;
	}

	r.bits      = 8;
	r.offset    = 16;
	r.msb_right = 0;
	g.bits      = 8;
	g.offset    = 8;
	g.msb_right = 0;
	b.bits      = 8;
	b.offset    = 0;
	b.msb_right = 0;
	def.red   = 0;
	def.green = 0;
	def.blue  = 0;
	if(init_agfx_plane(pd, toshmptr(*pd, &pdc->input_plane),
					r, g, b,
					4,
					pdc->line_length,
					pdc->mode.hdisplay,
					pdc->mode.vdisplay,
					def) != STUI_OK) {
		goto error_unmap;
	}
	pdc = fromshmptr(struct drm_ctl, *pd, dc);

	flush_drm_ctl(pd, dc);
	pdc = fromshmptr(struct drm_ctl, *pd, dc);

















	struct drm_mode_get_connector con = {0};
	con.connector_id = pdc->connector_id;

	if (ioctl(pdc->drm_fd, DRM_IOCTL_MODE_GETCONNECTOR, &con) < 0) {
		perror("GETCONNECTOR before SETCRTC failed");
		// ...
	}

	printf("Before SETCRTC:\n");
	printf("  connector_id = %u   connection = %d   encoder_id = %u\n",
		   pdc->connector_id, con.connection, con.encoder_id);

	struct drm_mode_get_encoder enc = {0};
	enc.encoder_id = pdc->encoder_id;

	if (ioctl(pdc->drm_fd, DRM_IOCTL_MODE_GETENCODER, &enc) < 0) {
		perror("GETENCODER before SETCRTC failed");
	} else {
		printf("  encoder_id   = %u   crtc_id = %u   possible_crtcs = 0x%08x\n",
			   pdc->encoder_id, enc.crtc_id, enc.possible_crtcs);
	}

	printf("  crtc_id we want to use = %u\n", pdc->crtc_id);

















	memset(&crtc, 0, sizeof(struct drm_mode_crtc));
	crtc.crtc_id    = pdc->crtc_id;
	crtc.fb_id      = pdc->fb_id;
	crtc.x          = 0;
	crtc.y          = 0;
	crtc.mode       = pdc->mode;
	crtc.mode_valid = 1;
	crtc.set_connectors_ptr = (uint64_t)&pdc->connector_id;
	crtc.count_connectors   = 1;
	if(ioctl(pdc->drm_fd, DRM_IOCTL_MODE_SETCRTC, &crtc) < 0) {
		/* ENOENT */
		goto error_unmap;
	}
	pdc->crtc = crtc;

	shm_leave(pd);
	return STUI_OK;

error_unmap:
	munmap(pdc->mapped_fb, pdc->size);
error_fb:
	ioctl(pdc->drm_fd, DRM_IOCTL_MODE_RMFB, &pdc->fb_id);
error_dumb:
	memset(&destroyreq, 0, sizeof(struct drm_mode_destroy_dumb));
	destroyreq.handle = pdc->handle;
	if(ioctl(pdc->drm_fd, DRM_IOCTL_MODE_DESTROY_DUMB, &destroyreq) < 0) {
		shm_leave(pd);
		return STUI_ERR;
	}
	if(ioctl(pdc->drm_fd, DRM_IOCTL_DROP_MASTER, 0) < 0) {
		shm_leave(pd);
		return STUI_ERR;
	}
	shm_leave(pd);
	return STUI_ERR;
}

void
free_drm_ctl(struct shm_allocator_pdata *pd, shmptr_of(struct drm_ctl) dc)
{
	struct drm_ctl *pdc;
	struct drm_mode_destroy_dumb destroyreq;

	shm_access(pd);
	pdc = fromshmptr(struct drm_ctl, *pd, dc);

	free_agfx_plane(pd, toshmptr(*pd, &pdc->input_plane));
	pdc = fromshmptr(struct drm_ctl, *pd, dc);

	munmap(pdc->mapped_fb, pdc->size);
	if(ioctl(pdc->drm_fd, DRM_IOCTL_MODE_RMFB, &pdc->fb_id) < 0) {
		shm_leave(pd);
		return;
	}

	memset(&destroyreq, 0, sizeof(struct drm_mode_destroy_dumb));
	destroyreq.handle = pdc->handle;
	if(ioctl(pdc->drm_fd, DRM_IOCTL_MODE_DESTROY_DUMB, &destroyreq) < 0) {
		shm_leave(pd);
		return;
	}

	if(ioctl(pdc->drm_fd, DRM_IOCTL_DROP_MASTER, 0) < 0) {
		shm_leave(pd);
		return;
	}

	shm_leave(pd);
}

shmptr_of(struct agfx_plane)
	get_drm_agfx_plane(struct shm_allocator_pdata *pd, shmptr_of(struct drm_ctl) dc)
{
	struct drm_ctl *pdc;

	pdc = fromshmptr(struct drm_ctl, *pd, dc);
	return toshmptr(*pd, &pdc->input_plane);
}

void
flush_drm_ctl(struct shm_allocator_pdata *pd, shmptr_of(struct drm_ctl) dc)
{
	struct drm_ctl *pdc;

	pdc = fromshmptr(struct drm_ctl, *pd, dc);

	memcpy(pdc->mapped_fb, fromshmptr(char, *pd, pdc->input_plane.data), pdc->size);
}

static int
check_device(char *name, int *fd, struct drm_mode_card_res *res, uint32_t *con_id, uint32_t *crtc_id, uint32_t *encoder_id, struct drm_mode_modeinfo *mode)
{
	uint32_t *connectors;
	uint32_t *fbs;
	uint32_t *crtcs;
	uint32_t *res_encoders;
	unsigned int i;
	struct drm_mode_get_connector con;
	struct drm_mode_modeinfo *modes;
	uint32_t *props;
	uint64_t *prop_values;
	uint32_t *con_encoders;
	struct drm_mode_get_encoder enc;

	*fd = open(name, O_RDWR | O_CLOEXEC);
	if(*fd < 0) {
		return 0;
	}

	memset(res, 0, sizeof(struct drm_mode_card_res));
	if(ioctl(*fd, DRM_IOCTL_MODE_GETRESOURCES, res) < 0) {
		if(close(*fd) < 0) {
			return 0;
		}
		return 0;
	}

	connectors = crtcs = res_encoders = NULL;
	if(res->count_connectors) {
		connectors = calloc(res->count_connectors, sizeof(uint32_t));
		if(! connectors) {
			return 0;
		}
		res->connector_id_ptr = (uint64_t)connectors;
	}
	if(res->count_crtcs) {
		crtcs = calloc(res->count_crtcs, sizeof(uint32_t));
		if(! crtcs) {
			if(connectors) free(connectors);
			return 0;
		}
		res->crtc_id_ptr = (uint64_t)crtcs;
	}
	if(res->count_encoders) {
		res_encoders = calloc(res->count_encoders, sizeof(uint32_t));
		if(! res_encoders) {
			if(connectors) free(connectors);
			if(crtcs) free(crtcs);
			return 0;
		}
		res->encoder_id_ptr = (uint64_t)res_encoders;
	}
	if(res->count_fbs) {
		fbs = calloc(res->count_fbs, sizeof(uint32_t));
		if(! fbs) {
			if(connectors) free(connectors);
			if(crtcs) free(crtcs);
			if(res_encoders) free(res_encoders);
			return 0;
		}
		res->fb_id_ptr = (uint64_t)fbs;
	}

	if(ioctl(*fd, DRM_IOCTL_MODE_GETRESOURCES, res) < 0) {
		goto fail;
	}

	for(i = 0; i < res->count_connectors; ++i) {
		memset(&con, 0, sizeof(struct drm_mode_get_connector));
		con.connector_id = connectors[i];

		if(ioctl(*fd, DRM_IOCTL_MODE_GETCONNECTOR, &con) < 0) {
			goto fail;
		}

		/* magic number for connected */
		if(con.connection != 1) {
			continue;
		}
		if(con.count_modes == 0) {
			continue;
		}

		modes = NULL;
		props = con_encoders = NULL;
		prop_values = NULL;
		if(con.count_modes) {
			modes = calloc(con.count_modes, sizeof(struct drm_mode_modeinfo));
			if(!modes) {
				continue;
			}
		}
		if(con.count_props) {
			props = calloc(con.count_props, sizeof(uint32_t));
			if(!props) {
				if(modes) free(modes);
				continue;
			}
		}
		if(con.count_props) {
			prop_values = calloc(con.count_props, sizeof(uint64_t));
			if(!prop_values) {
				if(modes) free(modes);
				if(props) free(props);
				continue;
			}
		}
		if(con.count_encoders) {
			con_encoders = calloc(con.count_encoders, sizeof(uint32_t));
			if(!con_encoders) {
				if(modes) free(modes);
				if(props) free(props);
				if(prop_values) free(prop_values);
				continue;
			}
		}

		con.modes_ptr       = (uint64_t)modes;
		con.props_ptr       = (uint64_t)props;
		con.prop_values_ptr = (uint64_t)prop_values;
		con.encoders_ptr    = (uint64_t)con_encoders;

        if (ioctl(*fd, DRM_IOCTL_MODE_GETCONNECTOR, &con) < 0) {
			goto fail_connector;
        }

		*con_id = con.connector_id;
		*mode = modes[0];
		*encoder_id = con.encoder_id;

		if(con.encoder_id) {
			memset(&enc, 0, sizeof(struct drm_mode_get_encoder));
			enc.encoder_id = con.encoder_id;
			if(ioctl(*fd, DRM_IOCTL_MODE_GETENCODER, &enc) < 0) {
				goto fail_connector;
			}

			if(enc.crtc_id) {
				*crtc_id = enc.crtc_id;

				if(modes) free(modes);
				if(props) free(props);
				if(prop_values) free(prop_values);
				if(con_encoders) free(con_encoders);

				return 1;
			}
		}

	fail_connector:
		if(modes) free(modes);
		if(props) free(props);
		if(prop_values) free(prop_values);
		if(con_encoders) free(con_encoders);
		continue;
	}

fail:
	if(connectors) free(connectors);
	if(crtcs) free(crtcs);
	if(res_encoders) free(res_encoders);
	if(fbs) free(fbs);
	if(close(*fd) < 0) {
		return 0;
	}
	return 0;
}

static int
check_devices(char **names, int *fd, struct drm_mode_card_res *res, uint32_t *con_id, uint32_t *crtc_id, uint32_t *encoder_id, struct drm_mode_modeinfo *mode)
{
	char **iter;

	for(iter = names; *iter; ++iter) {
		if(check_device(*iter, fd, res, con_id, crtc_id, encoder_id, mode)) {
			return 1;
		}
	}

	return 0;
}

